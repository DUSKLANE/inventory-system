# 存储模式: local=SQLite本地 | cloud=Upstash Redis
STORAGE_MODE=local

# Upstash Redis (cloud 模式必填)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 登录凭据
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123

# 会话签名密钥 (必填，至少 16 字符，用于签名登录 cookie；可用 `openssl rand -hex 32` 生成)
AUTH_SECRET=please-change-me-to-a-long-random-secret

# SQLite 数据库路径 (仅 local 模式)
SQLITE_DB_PATH=data/inventory.db
